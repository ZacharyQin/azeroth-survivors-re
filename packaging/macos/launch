#!/bin/bash
# First launch fetches the same 1.12.1 client archive as scripts/fetch-data.sh.
# Later launches skip the download when terrain.MPQ and patch.MPQ are already present.
# WOW_DATA, if set, is used as-is and nothing is downloaded.

MACOS="$(cd "$(dirname "$0")" && pwd)"
APP="$(cd "$MACOS/../.." && pwd)"
PARENT="$(dirname "$APP")"
SUPPORT="${HOME}/Library/Application Support/Azeroth Survivors"
DATA="${SUPPORT}/Data"
DEFAULT_DATA_URL="https://archive.org/download/WoW_1.12.1-5875/1.12.1-5875_enUS.zip"
URL="${WOW_DATA_URL:-$DEFAULT_DATA_URL}"
ZIP="${SUPPORT}/$(basename "${URL%%\?*}")"
LOG="${SUPPORT}/download.log"

has_data() {
  [ -f "$1/terrain.MPQ" ] && [ -f "$1/patch.MPQ" ]
}

fail() {
  osascript -e "display alert \"Azeroth Survivors\" message \"$1\"" >/dev/null 2>&1 || true
  echo "$1" >&2
  exit 1
}

fetch_into_support() {
  mkdir -p "$SUPPORT"
  if ! osascript -e 'display dialog "第一次打开需要下载游戏数据（约 5.5 GB）。下载完成后进入游戏。" buttons {"取消", "下载"} default button "下载" cancel button "取消" with title "Azeroth Survivors"' >/dev/null; then
    exit 0
  fi
  avail_kb="$(df -k "$SUPPORT" | awk 'NR==2 {print $4}')"
  if [ "${avail_kb:-0}" -lt 12582912 ]; then
    fail "磁盘剩余空间不足，需要大约 12 GB。"
  fi
  if ! command -v curl >/dev/null || ! command -v unzip >/dev/null; then
    fail "需要系统自带的 curl 和 unzip。"
  fi
  {
    echo "downloading $URL"
    caffeinate -i curl -fL --retry 3 --retry-delay 2 -C - -o "$ZIP" "$URL"
    echo "extracting $ZIP"
    mkdir -p "$DATA"
    unzip -o "$ZIP" 'Data/*.MPQ' -d "$SUPPORT"
  } >>"$LOG" 2>&1 || fail "下载或解压失败。详情见 ${LOG}"
  if ! has_data "$DATA"; then
    fail "压缩包里没有 Data/terrain.MPQ 和 Data/patch.MPQ。详情见 ${LOG}"
  fi
  rm -f "$ZIP"
}

if [ -z "${WOW_DATA+x}" ]; then
  if has_data "$DATA"; then
    export WOW_DATA="$DATA"
  elif has_data "${PARENT}/Data"; then
    export WOW_DATA="${PARENT}/Data"
  elif has_data "${PARENT}/WoW/Data"; then
    export WOW_DATA="${PARENT}/WoW/Data"
  else
    fetch_into_support
    export WOW_DATA="$DATA"
  fi
fi

echo "WOW_DATA=${WOW_DATA-<unset>}" >&2
exec "${MACOS}/warcraft-survivors"
